<Window x:Class="BetterMuv.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Better-Muv" Icon="Assets/Branding/app-icon.png" Width="980" Height="700" MinWidth="820" MinHeight="580" WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="Transparent" AllowsTransparency="True" Foreground="#F5F7FA" FontFamily="Microsoft YaHei" FontSize="14" SourceInitialized="Window_SourceInitialized" Closing="Window_Closing">
    <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" CornerRadius="14" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style TargetType="ScrollBar"><Setter Property="Visibility" Value="Collapsed"/></Style>
        <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#2A303A"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="18,16"/><Setter Property="Margin" Value="0,10,0,0"/></Style>
        <Style TargetType="Button"><Setter Property="Foreground" Value="#F4F6F8"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,8"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" SnapsToDevicePixels="True"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#35404E"/><Setter TargetName="Surface" Property="BorderBrush" Value="#4B596C"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#2C3541"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Foreground" Value="#F1F3F5"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,9"/><Setter Property="Margin" Value="6,2"/><Setter Property="FontSize" Value="13"/><Setter Property="HorizontalContentAlignment" Value="Left"/></Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Foreground" Value="#F7F8FA"/><Setter Property="Background" Value="#3B424E"/><Setter Property="BorderBrush" Value="#48515F"/><Setter Property="Padding" Value="12,6"/><Setter Property="FontSize" Value="13"/><Setter Property="MinHeight" Value="30"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8,6"/><Setter Property="MinWidth" Value="36"/><Setter Property="FontFamily" Value="Segoe Fluent Icons"/><Setter Property="FontSize" Value="16"/><Setter Property="Foreground" Value="#F4F6F8"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
        <Style x:Key="ToggleSwitch" TargetType="CheckBox"><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid Width="52" Height="29"><Border x:Name="Track" Background="#434C59" BorderBrush="#53606F" BorderThickness="1" CornerRadius="15"/><Ellipse x:Name="Thumb" Width="21" Height="21" Fill="#F6F7F9" HorizontalAlignment="Left" Margin="4,0,0,0"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#3EA6F1"/><Setter TargetName="Track" Property="BorderBrush" Value="#55B3F6"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Thumb" Property="Margin" Value="0,0,4,0"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="MazeSettingsNavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Padding" Value="14,7"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="FontSize" Value="13"/><Setter Property="MinWidth" Value="0"/></Style>
        <Style x:Key="PriorityList" TargetType="ListBox"><Setter Property="Background" Value="#1B212A"/><Setter Property="BorderBrush" Value="#46505E"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="6"/><Setter Property="FontSize" Value="16"/><Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="#F2F5F8"/><Setter Property="FontSize" Value="16"/><Setter Property="Padding" Value="14,12"/><Setter Property="Margin" Value="0,3"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemSurface" Background="Transparent" CornerRadius="6"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#3B4657"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></Setter.Value></Setter></Style>
        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#1B212A"/>
            <Setter Property="Foreground" Value="#F5F7FA"/>
            <Setter Property="BorderBrush" Value="#46505E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#F5F7FA"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemSurface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemSurface" Property="Background" Value="#3B4657"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemSurface" Property="Background" Value="#3EA6F1"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.45"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ComboBorder" Background="#1B212A" BorderBrush="#46505E" BorderThickness="1" CornerRadius="7" SnapsToDevicePixels="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="28"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Background="Transparent"/>
                                                <Path Grid.Column="1" Data="M0,0 L6,6 L12,0" Stroke="#F5F7FA" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" Width="12" Height="6" Stretch="Fill"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#5B6A80"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#3EA6F1"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" Margin="10,0,30,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                            <!-- IsEditable 时必须有 PART_EditableTextBox，否则选中后不显示文字 -->
                            <TextBox x:Name="PART_EditableTextBox"
                                     Visibility="Collapsed"
                                     Background="Transparent"
                                     Foreground="#F5F7FA"
                                     CaretBrush="#F5F7FA"
                                     BorderThickness="0"
                                     Margin="10,0,30,0"
                                     Padding="0"
                                     VerticalAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     FontSize="{TemplateBinding FontSize}"
                                     Focusable="True"
                                     HorizontalAlignment="Stretch"/>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border x:Name="DropDown" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Background="#1B212A" BorderBrush="#46505E" BorderThickness="1" CornerRadius="8" Margin="0,4,0,0" Padding="4">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" Opacity="0.35" BlurRadius="12" ShadowDepth="2"/>
                                    </Border.Effect>
                                    <ScrollViewer Margin="0" SnapsToDevicePixels="True" CanContentScroll="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="DropDown" Property="MinHeight" Value="40"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox"><Setter Property="Background" Value="#1B212A"/><Setter Property="Foreground" Value="#F5F7FA"/><Setter Property="BorderBrush" Value="#3C4655"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="8,4"/><Setter Property="MinHeight" Value="28"/><Setter Property="FontSize" Value="13"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True"><ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="#5B6A80"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#EAF0F7"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border x:Name="Box" Width="20" Height="20" Background="#1B212A" BorderBrush="#4A5667" BorderThickness="1" CornerRadius="5" VerticalAlignment="Center"/><TextBlock x:Name="Mark" Text="✓" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/><ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#3EA6F1"/><Setter TargetName="Box" Property="BorderBrush" Value="#3EA6F1"/><Setter TargetName="Mark" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style TargetType="RadioButton"><Setter Property="Foreground" Value="#EEF2F6"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border x:Name="Ring" Width="20" Height="20" Background="#1B212A" BorderBrush="#667487" BorderThickness="2" CornerRadius="10" VerticalAlignment="Center"/><Ellipse x:Name="Dot" Width="10" Height="10" Fill="#3EA6F1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/><ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Ring" Property="BorderBrush" Value="#3EA6F1"/><Setter TargetName="Dot" Property="Visibility" Value="Visible"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    </Window.Resources>
    <Border Margin="8" Background="Transparent">
        <Border.Effect><DropShadowEffect Color="#000000" Opacity="0.32" BlurRadius="18" ShadowDepth="4"/></Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="LogDrawerColumn" Width="0"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="WindowFrame" Background="#202630" BorderBrush="#3B4553" BorderThickness="1" CornerRadius="14" SizeChanged="WindowFrame_SizeChanged">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="62"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Background="#182029" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="48"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                        <Border Width="26" Height="26" CornerRadius="13" ClipToBounds="True">
                            <Image Source="Assets/Branding/app-icon.png" Stretch="UniformToFill"/>
                        </Border>
                        <TextBlock x:Name="TitleBarText" Margin="10,0,0,0" FontSize="16" VerticalAlignment="Center" Text="Better-Muv"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="—" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="16" Click="MinimizeButton_Click"/>
                    <Button Grid.Column="2" Content="×" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="22" Click="CloseButton_Click"/>
                </Grid>
            <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="148"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="#182029"><Grid><Grid.RowDefinitions><RowDefinition Height="10"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Grid.Row="1"><Button x:Name="HomeNavButton" Style="{StaticResource NavButton}" FontSize="15" Content="⌂  首页" Click="ShowHomeButton_Click"/><Button x:Name="ExecuteNavButton" Style="{StaticResource NavButton}" FontSize="15" Content="▷  任务" Click="ShowExecuteButton_Click"/></StackPanel><Button Grid.Row="2" x:Name="SettingsNavButton" Style="{StaticResource NavButton}" Margin="4,0,4,12" Click="ShowSettingsButton_Click"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock FontFamily="Segoe Fluent Icons" FontSize="15" Text="&#xE713;" VerticalAlignment="Center"/><TextBlock Margin="8,0,0,0" Text="设置" VerticalAlignment="Center"/></StackPanel></Button></Grid></Border>
            <ScrollViewer x:Name="HomePanel" Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="28,22,28,24">
                <Border Height="210" CornerRadius="12" ClipToBounds="True"><Border.Background><ImageBrush ImageSource="Assets/Branding/home-banner.png" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" RelativeTransform="1.15,0,0,1.15,0,0"/></Border.Background><Border CornerRadius="12"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#D9141B24"/><GradientStop Color="#90141B24" Offset=".45"/><GradientStop Color="#20141B24" Offset="1"/></LinearGradientBrush></Border.Background><StackPanel Margin="32,0" VerticalAlignment="Center"><TextBlock Text="Better-Muv" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="更好的 MuvLuv Girls Garden" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border></Border>
                <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="▷" FontSize="22" VerticalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="启动一条龙" FontSize="17"/><TextBlock Text="按任务页开关与顺序依次执行" Foreground="#AEB8C5" FontSize="12"/></StackPanel><Button x:Name="CaptureStartButton" Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="▷  启动" Click="CaptureStartButton_Click"/></Grid></Border>
                <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions><TextBlock Text="▤" FontSize="21" VerticalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="运行窗口" FontSize="17"/><TextBlock Text="默认使用游戏窗口；浏览器选择会自动保存" Foreground="#AEB8C5" FontSize="12"/></StackPanel><ComboBox x:Name="RunWindowComboBox" Grid.Column="2" Style="{StaticResource DarkComboBox}" DropDownOpened="RunWindowComboBox_DropDownOpened" SelectionChanged="RunWindowComboBox_SelectionChanged"/></Grid></Border>
                <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="◉" FontSize="21" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="同时启动 MuvLuv Girls Garden" FontSize="17" VerticalAlignment="Center"/><Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Click="GameSettingsButton_Click"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock FontFamily="Segoe Fluent Icons" FontSize="14" Text="&#xE713;" VerticalAlignment="Center"/><TextBlock Margin="6,0,0,0" Text="设置" VerticalAlignment="Center"/></StackPanel></Button><CheckBox x:Name="LaunchGameCheckBox" Grid.Column="3" Style="{StaticResource ToggleSwitch}" Margin="14,0,0,0" Checked="LaunchGameCheckBox_Changed" Unchecked="LaunchGameCheckBox_Changed"/></Grid></Border>
                <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="▣" FontSize="21" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Better-Muv 桌面分身" FontSize="17" VerticalAlignment="Center"/><Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="打开" Click="OpenCloneButton_Click"/></Grid></Border>
            </StackPanel></ScrollViewer>
            <ScrollViewer x:Name="ExecutionPanel" Grid.Column="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28,22,28,24">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="任务列表" FontSize="22" FontWeight="SemiBold"/>
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="运行日志" Click="ShowLogDrawerButton_Click"/>
                    </Grid>
                    <Grid Margin="0,12,0,4">
                        <Button x:Name="RunPipelineButton" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" MinHeight="40" FontSize="15" Content="运行" Click="RunPipelineButton_Click"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="PausePipelineButton" Style="{StaticResource IconButton}" Content="&#xE769;" ToolTip="暂停" Visibility="Collapsed" Click="PauseResumeButton_Click"/>
                            <Button x:Name="StopPipelineButton" Style="{StaticResource IconButton}" Content="&#xE71A;" ToolTip="停止" Visibility="Collapsed" Click="StopButton_Click"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel x:Name="TaskListPanel" AllowDrop="True" Grid.IsSharedSizeScope="True"
                                PreviewDragOver="TaskList_DragOver" PreviewDrop="TaskList_Drop" PreviewDragLeave="TaskList_DragLeave">
                        <Border x:Name="MazeTaskCard" Style="{StaticResource Card}" Tag="maze" Cursor="SizeAll" ToolTip="拖动调整顺序"
                                PreviewMouseLeftButtonDown="TaskCard_PreviewMouseLeftButtonDown" MouseMove="TaskCard_MouseMove" PreviewMouseLeftButtonUp="TaskCard_PreviewMouseLeftButtonUp">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="TaskRun"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="TaskPause"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="TaskStop"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="TaskSettings"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="TaskToggle"/>
                                </Grid.ColumnDefinitions>
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="迷宫探索" FontSize="16"/>
                                        <TextBlock x:Name="MazeStatusText" Visibility="Collapsed"/>
                                        <TextBlock x:Name="MazePipelineResultText" FontSize="13" FontWeight="SemiBold" Margin="0,3,0,0" Visibility="Collapsed"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,10,0">
                                        <TextBlock Text="次数" VerticalAlignment="Center" Foreground="#AEB8C5" FontSize="13" Margin="0,0,8,0"/>
                                        <ComboBox x:Name="MazeRunLimitCombo" Style="{StaticResource DarkComboBox}"
                                                  IsEditable="True" IsTextSearchEnabled="False"
                                                  Width="84" Height="32" Padding="8,2"
                                                  ToolTip="可下拉选「无限」或直接输入数字"
                                                  LostKeyboardFocus="MazeRunLimitCombo_LostKeyboardFocus"
                                                  SelectionChanged="MazeRunLimitCombo_SelectionChanged"
                                                  Loaded="MazeRunLimitCombo_Loaded"/>
                                    </StackPanel>
                                </Grid>
                                <Button x:Name="RunMazeButton" Grid.Column="1" Style="{StaticResource IconButton}" MinWidth="36" Content="&#xE768;" ToolTip="运行" Click="RunMazeButton_Click"/>
                                <Button x:Name="PauseResumeButton" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE769;" ToolTip="暂停" Visibility="Collapsed" Click="PauseResumeButton_Click"/>
                                <Button x:Name="StopButton" Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE71A;" ToolTip="停止" Visibility="Collapsed" Click="StopButton_Click"/>
                                <Button Grid.Column="4" Style="{StaticResource IconButton}" MinWidth="36" ToolTip="迷宫探索设置" Click="MazeSettingsButton_Click" Content="&#xE713;"/>
                                <CheckBox x:Name="MazePipelineToggle" Grid.Column="5" Style="{StaticResource ToggleSwitch}" Margin="10,0,0,0" ToolTip="纳入一条龙" Checked="PipelineTaskToggle_Changed" Unchecked="PipelineTaskToggle_Changed"/>
                            </Grid>
                        </Border>
                        <Border x:Name="MainQuestTaskCard" Style="{StaticResource Card}" Tag="mainQuest" Cursor="SizeAll" ToolTip="拖动调整顺序"
                                PreviewMouseLeftButtonDown="TaskCard_PreviewMouseLeftButtonDown" MouseMove="TaskCard_MouseMove" PreviewMouseLeftButtonUp="TaskCard_PreviewMouseLeftButtonUp">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="TaskRun"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="TaskPause"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="TaskStop"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="TaskSettings"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="TaskToggle"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="自动主线任务" FontSize="16"/>
                                    <TextBlock x:Name="MainQuestStatusText" Visibility="Collapsed"/>
                                    <TextBlock x:Name="MainQuestPipelineResultText" FontSize="13" FontWeight="SemiBold" Margin="0,3,0,0" Visibility="Collapsed"/>
                                </StackPanel>
                                <Button x:Name="RunMainQuestButton" Grid.Column="1" Style="{StaticResource IconButton}" MinWidth="36" Content="&#xE768;" ToolTip="运行" Click="RunMainQuestButton_Click"/>
                                <Button x:Name="PauseMainQuestButton" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE769;" ToolTip="暂停" Visibility="Collapsed" Click="PauseResumeButton_Click"/>
                                <Button x:Name="StopMainQuestButton" Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE71A;" ToolTip="停止" Visibility="Collapsed" Click="StopButton_Click"/>
                                <Button Grid.Column="4" Style="{StaticResource IconButton}" MinWidth="36" Visibility="Hidden" IsHitTestVisible="False" Focusable="False" Content="&#xE713;"/>
                                <CheckBox x:Name="MainQuestPipelineToggle" Grid.Column="5" Style="{StaticResource ToggleSwitch}" Margin="10,0,0,0" ToolTip="纳入一条龙" Checked="PipelineTaskToggle_Changed" Unchecked="PipelineTaskToggle_Changed"/>
                            </Grid>
                        </Border>
                        <Border x:Name="HardMainQuestTaskCard" Style="{StaticResource Card}" Tag="hardMainQuest" Cursor="SizeAll" ToolTip="拖动调整顺序"
                                PreviewMouseLeftButtonDown="TaskCard_PreviewMouseLeftButtonDown" MouseMove="TaskCard_MouseMove" PreviewMouseLeftButtonUp="TaskCard_PreviewMouseLeftButtonUp">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="TaskRun"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="TaskPause"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="TaskStop"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="TaskSettings"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="TaskToggle"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="自动困难主线" FontSize="16"/>
                                    <TextBlock x:Name="HardMainQuestStatusText" Visibility="Collapsed"/>
                                    <TextBlock x:Name="HardMainQuestPipelineResultText" FontSize="13" FontWeight="SemiBold" Margin="0,3,0,0" Visibility="Collapsed"/>
                                </StackPanel>
                                <Button x:Name="RunHardMainQuestButton" Grid.Column="1" Style="{StaticResource IconButton}" MinWidth="36" Content="&#xE768;" ToolTip="运行" Click="RunHardMainQuestButton_Click"/>
                                <Button x:Name="PauseHardMainQuestButton" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE769;" ToolTip="暂停" Visibility="Collapsed" Click="PauseResumeButton_Click"/>
                                <Button x:Name="StopHardMainQuestButton" Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE71A;" ToolTip="停止" Visibility="Collapsed" Click="StopButton_Click"/>
                                <Button Grid.Column="4" Style="{StaticResource IconButton}" MinWidth="36" Visibility="Hidden" IsHitTestVisible="False" Focusable="False" Content="&#xE713;"/>
                                <CheckBox x:Name="HardMainQuestPipelineToggle" Grid.Column="5" Style="{StaticResource ToggleSwitch}" Margin="10,0,0,0" ToolTip="纳入一条龙" Checked="PipelineTaskToggle_Changed" Unchecked="PipelineTaskToggle_Changed"/>
                            </Grid>
                        </Border>
                        <Border x:Name="DailyShopTaskCard" Style="{StaticResource Card}" Tag="dailyShop" Cursor="SizeAll" ToolTip="拖动调整顺序"
                                PreviewMouseLeftButtonDown="TaskCard_PreviewMouseLeftButtonDown" MouseMove="TaskCard_MouseMove" PreviewMouseLeftButtonUp="TaskCard_PreviewMouseLeftButtonUp">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="TaskRun"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="TaskPause"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="TaskStop"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="TaskSettings"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="TaskToggle"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="每日商店" FontSize="16"/>
                                    <TextBlock x:Name="DailyShopStatusText" Visibility="Collapsed"/>
                                    <TextBlock x:Name="DailyShopPipelineResultText" FontSize="13" FontWeight="SemiBold" Margin="0,3,0,0" Visibility="Collapsed"/>
                                </StackPanel>
                                <Button x:Name="RunDailyShopButton" Grid.Column="1" Style="{StaticResource IconButton}" MinWidth="36" Content="&#xE768;" ToolTip="运行" Click="RunDailyShopButton_Click"/>
                                <Button x:Name="PauseDailyShopButton" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE769;" ToolTip="暂停" Visibility="Collapsed" Click="PauseResumeButton_Click"/>
                                <Button x:Name="StopDailyShopButton" Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE71A;" ToolTip="停止" Visibility="Collapsed" Click="StopButton_Click"/>
                                <Button Grid.Column="4" Style="{StaticResource IconButton}" MinWidth="36" Visibility="Hidden" IsHitTestVisible="False" Focusable="False" Content="&#xE713;"/>
                                <CheckBox x:Name="DailyShopPipelineToggle" Grid.Column="5" Style="{StaticResource ToggleSwitch}" Margin="10,0,0,0" ToolTip="纳入一条龙" Checked="PipelineTaskToggle_Changed" Unchecked="PipelineTaskToggle_Changed"/>
                            </Grid>
                        </Border>
                        <Border x:Name="DailyFreeGiftTaskCard" Style="{StaticResource Card}" Tag="dailyFreeGift" Cursor="SizeAll" ToolTip="拖动调整顺序"
                                PreviewMouseLeftButtonDown="TaskCard_PreviewMouseLeftButtonDown" MouseMove="TaskCard_MouseMove" PreviewMouseLeftButtonUp="TaskCard_PreviewMouseLeftButtonUp">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="TaskRun"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="TaskPause"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="TaskStop"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="TaskSettings"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="TaskToggle"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="每日免费礼包" FontSize="16"/>
                                    <TextBlock x:Name="DailyFreeGiftStatusText" Visibility="Collapsed"/>
                                    <TextBlock x:Name="DailyFreeGiftPipelineResultText" FontSize="13" FontWeight="SemiBold" Margin="0,3,0,0" Visibility="Collapsed"/>
                                </StackPanel>
                                <Button x:Name="RunDailyFreeGiftButton" Grid.Column="1" Style="{StaticResource IconButton}" MinWidth="36" Content="&#xE768;" ToolTip="运行" Click="RunDailyFreeGiftButton_Click"/>
                                <Button x:Name="PauseDailyFreeGiftButton" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE769;" ToolTip="暂停" Visibility="Collapsed" Click="PauseResumeButton_Click"/>
                                <Button x:Name="StopDailyFreeGiftButton" Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE71A;" ToolTip="停止" Visibility="Collapsed" Click="StopButton_Click"/>
                                <Button Grid.Column="4" Style="{StaticResource IconButton}" MinWidth="36" Visibility="Hidden" IsHitTestVisible="False" Focusable="False" Content="&#xE713;"/>
                                <CheckBox x:Name="DailyFreeGiftPipelineToggle" Grid.Column="5" Style="{StaticResource ToggleSwitch}" Margin="10,0,0,0" ToolTip="纳入一条龙" Checked="PipelineTaskToggle_Changed" Unchecked="PipelineTaskToggle_Changed"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <Grid x:Name="SettingsPanel" Grid.Column="1" Visibility="Collapsed" Margin="20,14,20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="设置" FontSize="20" FontWeight="SemiBold"/>
                <Border Grid.Row="1" Background="#182029" CornerRadius="10" Padding="6,4" Margin="0,8,0,10" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="SettingsGeneralNavButton" Style="{StaticResource MazeSettingsNavButton}" Margin="0" Content="全局" Click="ShowSettingsGeneralButton_Click"/>
                        <Button x:Name="SettingsHotkeyNavButton" Style="{StaticResource MazeSettingsNavButton}" Margin="4,0,0,0" Content="快捷键" Click="ShowSettingsHotkeyButton_Click"/>
                        <Button x:Name="SettingsRedeemNavButton" Style="{StaticResource MazeSettingsNavButton}" Margin="4,0,0,0" Content="兑换码" Click="ShowSettingsRedeemButton_Click"/>
                    </StackPanel>
                </Border>
                <Grid Grid.Row="2">
                    <ScrollViewer x:Name="SettingsGeneralSection" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border x:Name="GameSettingsCard" Style="{StaticResource Card}" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="选择游戏路径" FontSize="16"/>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBox x:Name="GamePathBox" IsReadOnly="True"/>
                                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Content="自动搜索" Click="FindGameButton_Click"/>
                                        <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Content="浏览" Click="BrowseGameButton_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="全局设置" FontSize="16"/>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="保存诊断截图" VerticalAlignment="Center"/>
                                        <CheckBox x:Name="DiagnosticModeCheckBox" Grid.Column="1" Style="{StaticResource ToggleSwitch}" Checked="DiagnosticModeCheckBox_Changed" Unchecked="DiagnosticModeCheckBox_Changed"/>
                                    </Grid>
                                    <TextBlock Text="模板定位" FontSize="14" Margin="0,14,0,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBox x:Name="LocatorTemplatePathBox" IsReadOnly="True"/>
                                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="选择图片" Margin="8,0,0,0" Click="SelectLocatorTemplateButton_Click"/>
                                        <Button x:Name="LocateTemplateButton" Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="定位 ROI" Margin="8,0,0,0" Click="LocateTemplateButton_Click"/>
                                    </Grid>
                                    <TextBlock x:Name="LocatorResultText" Foreground="#BFD3E5" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <Border x:Name="SettingsHotkeySection" Style="{StaticResource Card}" Margin="0" Visibility="Collapsed" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="快捷键" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="仅支持 F1–F12，且两项不能相同。启动键在运行中会停止任务（不是暂停）。" Foreground="#AEB9C5" Margin="0,4,0,12"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                                <TextBlock Text="启动 / 停止" VerticalAlignment="Center"/>
                                <TextBox x:Name="PauseHotkeyBox" Grid.Column="1" LostKeyboardFocus="HotkeyBoxes_LostKeyboardFocus"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                                <TextBlock Text="停止" VerticalAlignment="Center"/>
                                <TextBox x:Name="StopHotkeyBox" Grid.Column="1" LostKeyboardFocus="HotkeyBoxes_LostKeyboardFocus"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <ScrollViewer x:Name="SettingsRedeemSection" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel>
                            <Border Style="{StaticResource Card}" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="兑换码" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="SettingsRedeemStatusText" Foreground="#AEB8C5" FontSize="12" Margin="0,8,0,0" Text="尚未同步"/>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="有未用码时询问是否兑换" VerticalAlignment="Center"/>
                                        <CheckBox x:Name="RedeemPromptCheckBox" Grid.Column="1" Style="{StaticResource ToggleSwitch}" Checked="RedeemPromptCheckBox_Changed" Unchecked="RedeemPromptCheckBox_Changed"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <Button Style="{StaticResource PrimaryButton}" Content="兑换未用码" Click="RunRedeemUnusedButton_Click"/>
                                        <Button Style="{StaticResource PrimaryButton}" Content="打开网页" Margin="8,0,0,0" Click="OpenRedemptionWebButton_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <StackPanel x:Name="SettingsRedeemListPanel"/>
                            <TextBlock x:Name="SettingsRedeemEmptyText" Text="暂无兑换码。" Foreground="#AEB8C5" FontSize="13" Margin="8,16,8,8" HorizontalAlignment="Center" Visibility="Collapsed"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
            <Grid x:Name="MazeSettingsPanel" Grid.Column="1" Visibility="Collapsed" Margin="20,14,20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,2">
                    <TextBlock Text="迷宫探索设置" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button x:Name="MazeSettingsBackButton" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                            Content="‹  返回" Click="ReturnToExecutionButton_Click"/>
                </Grid>
                <Border Grid.Row="1" Background="#182029" CornerRadius="10" Padding="6,4" Margin="0,8,0,10" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="MazeBasicNavButton" Style="{StaticResource MazeSettingsNavButton}" Margin="0" Content="探索" Click="ShowMazeBasicSettingsButton_Click"/>
                        <Button x:Name="MazeTreasureNavButton" Style="{StaticResource MazeSettingsNavButton}" Margin="4,0,0,0" Content="宝物优先级" Click="ShowMazeTreasureSettingsButton_Click"/>
                        <Button x:Name="MazeShopNavButton" Style="{StaticResource MazeSettingsNavButton}" Margin="4,0,0,0" Content="结算商店" Click="ShowMazeShopSettingsButton_Click"/>
                    </StackPanel>
                </Border>
                <Grid Grid.Row="2">
                    <Border x:Name="MazeBasicSettingsSection" Style="{StaticResource Card}" Margin="0" VerticalAlignment="Top" HorizontalAlignment="Stretch">
                        <StackPanel>
                            <TextBlock Text="探索" FontSize="16" FontWeight="SemiBold"/>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="难度选择"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <RadioButton x:Name="DifficultyKeepRadio" Content="保持不变" GroupName="Difficulty" Checked="DifficultyMode_Changed"/>
                                        <RadioButton x:Name="DifficultyCustomRadio" Content="自选" GroupName="Difficulty" Margin="16,0,0,0" Checked="DifficultyMode_Changed"/>
                                        <RadioButton x:Name="DifficultyTowerRadio" Content="爬塔" GroupName="Difficulty" Margin="16,0,0,0" Checked="DifficultyMode_Changed"
                                                     ToolTip="层选界面须无右箭头；保持当前层进入"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBox x:Name="DifficultyTargetBox" Grid.Column="1" VerticalAlignment="Center" LostKeyboardFocus="DifficultyTargetBox_LostKeyboardFocus"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border x:Name="MazeTreasureSettingsSection" Style="{StaticResource Card}" Margin="0" Visibility="Collapsed" VerticalAlignment="Stretch">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="宝物优先级" FontSize="16" FontWeight="SemiBold"/>
                            <Grid Grid.Row="1" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ListBox x:Name="TreasurePriorityList" Style="{StaticResource PriorityList}" VerticalAlignment="Stretch"/>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Top">
                                    <Button Style="{StaticResource PrimaryButton}" Content="置顶" MinWidth="64" Click="MovePriorityTop_Click"/>
                                    <Button Style="{StaticResource PrimaryButton}" Content="上移" MinWidth="64" Margin="0,8,0,0" Click="MovePriorityUp_Click"/>
                                    <Button Style="{StaticResource PrimaryButton}" Content="下移" MinWidth="64" Margin="0,8,0,0" Click="MovePriorityDown_Click"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                    <Border x:Name="MazeShopSettingsSection" Style="{StaticResource Card}" Margin="0" Visibility="Collapsed" VerticalAlignment="Stretch">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="结算商店购买" FontSize="16" FontWeight="SemiBold"/>
                            <Grid Grid.Row="1" Margin="0,10,0,8">
                                <StackPanel x:Name="ShopCategoryPanel" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="大类全买" Foreground="#BEC7D2" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <CheckBox x:Name="ShopCategoryBuyAllSwitch" Style="{StaticResource ToggleSwitch}"
                                              ToolTip="将该大类下所有小类商品设为全买"
                                              Checked="ShopCategoryBuyAllSwitch_Changed"
                                              Unchecked="ShopCategoryBuyAllSwitch_Changed"/>
                                </StackPanel>
                            </Grid>
                            <Border Grid.Row="2" Background="#202630" CornerRadius="10" Padding="10">
                                <DockPanel LastChildFill="True">
                                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                        <StackPanel x:Name="ShopSubcategoryPanel" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="小类全买" Foreground="#BEC7D2" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <CheckBox x:Name="ShopSubcategoryBuyAllSwitch" Style="{StaticResource ToggleSwitch}"
                                                      ToolTip="将当前小类（本页）所有商品设为全买"
                                                      Checked="ShopSubcategoryBuyAllSwitch_Changed"
                                                      Unchecked="ShopSubcategoryBuyAllSwitch_Changed"/>
                                        </StackPanel>
                                    </Grid>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <Grid x:Name="ShopItemGrid">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        </Grid>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="ResetShopCategoryButton" Style="{StaticResource PrimaryButton}" Click="ResetCurrentShopCategoryPurchases_Click"/>
                                <Button Style="{StaticResource PrimaryButton}" Content="重置当前页面数量" Margin="8,0,0,0" Click="ResetCurrentShopPagePurchases_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
            </Grid>
        </Grid>
        </Border>
            <Border x:Name="LogDrawer" Grid.Column="1" Background="#202630" BorderBrush="#3B4553" BorderThickness="1" CornerRadius="14" Visibility="Collapsed" SizeChanged="WindowFrame_SizeChanged">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="62"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Background="#182029">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="48"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="运行日志" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,0,0"/>
                        <Button x:Name="ExportLogButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" Padding="10,6" MinHeight="30" Margin="0,0,4,0" Content="导出" ToolTip="导出日志和截图到 Better-Muv 文件夹并打开位置" Click="ExportLogButton_Click"/>
                        <Button Grid.Column="2" Content="×" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="22" Click="CloseLogDrawerButton_Click"/>
                    </Grid>
                    <TextBox x:Name="LogBox" Grid.Row="1" Margin="12,8,12,12" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Background="#171C23" BorderThickness="0" Padding="10" FontFamily="Consolas" FontSize="12" VerticalAlignment="Stretch" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
