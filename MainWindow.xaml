<Window x:Class="BetterMuv.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Better-Muv" Width="1080" Height="720"
        MinWidth="900" MinHeight="620"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="#202630" Foreground="#F5F7FA"
        FontFamily="Microsoft YaHei UI"
        SourceInitialized="Window_SourceInitialized"
        ContentRendered="Window_ContentRendered"
        Closing="Window_Closing">
    <Window.Resources>
        <!-- 全局隐藏滚动条（仍可用滚轮滚动） -->
        <Style TargetType="ScrollBar">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Width" Value="0" />
            <Setter Property="Height" Value="0" />
        </Style>
        <Style TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="48" Height="28">
                            <Border x:Name="Track" CornerRadius="14" Background="#3A4552" />
                            <Border x:Name="Thumb" Width="22" Height="22" CornerRadius="11"
                                    Background="#F5F7FA" HorizontalAlignment="Left" Margin="3,0,0,0"
                                    VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#2196E8" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="#D7DCE3" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="18,12" />
            <Setter Property="Margin" Value="8,2" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#2C3440" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#2B323D" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="22" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#2196E8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="22,9" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#343C48" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#1B2129" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="46" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                    <Border Width="22" Height="22" CornerRadius="5" Background="#2196E8">
                        <TextBlock Text="M" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                               Text="Better-Muv · 自动迷宫探索" FontSize="14" />
                </StackPanel>
                <Button Grid.Column="1" Content="—" Background="Transparent" Foreground="#D7DCE3"
                        BorderThickness="0" FontSize="16" Click="MinimizeButton_Click" />
                <Button Grid.Column="2" Content="×" Background="Transparent" Foreground="#D7DCE3"
                        BorderThickness="0" FontSize="22" Click="CloseButton_Click" />
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#1B2129">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Margin="22,22,0,18" Text="功能" Foreground="#77808D" FontSize="12" />
                        <StackPanel Grid.Row="1">
                            <Button x:Name="HomeNavButton" Style="{StaticResource NavButton}"
                                    Background="#303946" Foreground="White"
                                    Content="▶   启动" Click="ShowHomeButton_Click" />
                            <Button x:Name="ShopNavButton" Style="{StaticResource NavButton}"
                                    Content="🛒   商店购买" Click="ShowShopButton_Click" />
                            <Button x:Name="PriorityNavButton" Style="{StaticResource NavButton}"
                                    Content="◆   宝物优先级" Click="ShowPriorityButton_Click" />
                            <Button x:Name="HotkeyNavButton" Style="{StaticResource NavButton}"
                                    Content="⚡   快捷键" Click="ShowHotkeyButton_Click" />
                        </StackPanel>
                        <Button Grid.Row="2" x:Name="SettingsNavButton" Style="{StaticResource NavButton}"
                                Margin="8,0,8,14" Content="⚙   设置" Click="ShowSettingsButton_Click" />
                    </Grid>
                </Border>

                <ScrollViewer x:Name="HomePanel" Grid.Column="1">
                    <StackPanel Margin="42,26,42,30">
                        <Border Height="178" CornerRadius="10">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#162B46" />
                                    <GradientStop Offset="0.55" Color="#204F73" />
                                    <GradientStop Offset="1" Color="#2A89B8" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid ClipToBounds="True">
                                <Ellipse Width="330" Height="330" Fill="#20FFFFFF"
                                         HorizontalAlignment="Right" Margin="0,-140,-80,0" />
                                <Ellipse Width="190" Height="190" Fill="#16FFFFFF"
                                         HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                         Margin="0,0,170,-100" />
                                <StackPanel Margin="44,0,0,30" VerticalAlignment="Bottom">
                                    <TextBlock Text="Better-Muv" FontSize="32" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,5,0,0" Text="自动识别界面，持续探索迷宫"
                                               Foreground="#D8EAF4" FontSize="17" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="▷" FontSize="34" Foreground="#DCE3EA" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Margin="18,0,28,0" VerticalAlignment="Center">
                                    <TextBlock Text="Better-Muv 自动化，启动！" FontSize="17" />
                                    <TextBlock Margin="0,5,0,0"
                                               Text="自动判断当前界面，执行入口流程并循环探索迷宫。"
                                               Foreground="#9EA7B3" FontSize="13" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}"
                                            Content="▶  启动" Click="StartButton_Click" />
                                    <Button x:Name="StopButton" Style="{StaticResource PrimaryButton}"
                                            Margin="8,0,0,0" Background="#D54F5C"
                                            Content="■  停止" IsEnabled="False" Click="StopButton_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="迷宫次数" FontSize="16" />
                                    <TextBlock Margin="0,5,0,0"
                                               Text="结算完了算一轮；0 为无限循环。"
                                               Foreground="#9EA7B3" FontSize="13" />
                                </StackPanel>
                                <TextBox x:Name="MazeRunLimitBox" Grid.Column="1"
                                         Width="88" Height="36" FontSize="16"
                                         VerticalContentAlignment="Center"
                                         HorizontalContentAlignment="Center"
                                         Background="#171C23" Foreground="#F5F7FA"
                                         BorderBrush="#3A4552" BorderThickness="1"
                                         LostKeyboardFocus="MazeRunLimitBox_LostKeyboardFocus"
                                         KeyDown="MazeRunLimitBox_KeyDown" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="250" />
                                </Grid.RowDefinitions>
                                <TextBlock Margin="20,15" Text="运行日志" FontSize="15" />
                                <TextBox x:Name="LogBox" Grid.Row="1" Margin="1"
                                         IsReadOnly="True" AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Hidden"
                                         HorizontalScrollBarVisibility="Disabled"
                                         Background="#171C23" Foreground="#C9D1DA"
                                         BorderThickness="0" Padding="14"
                                         FontFamily="Consolas" FontSize="12"
                                         TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Grid x:Name="ShopPanel" Grid.Column="1" Visibility="Collapsed" Margin="28,24,28,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="商店购买" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Margin="0,6,0,0"
                                   Text="数量：-1 全买，0 不买，正数为购买/强化次数。布局与游戏商店一致。"
                                   Foreground="#9EA7B3" TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="#1B2129" CornerRadius="9,0,0,9">
                                <StackPanel x:Name="ShopCategoryPanel" Margin="10,14" />
                            </Border>
                            <Grid Grid.Column="1" Margin="18,16,18,16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel x:Name="ShopSubcategoryPanel" Orientation="Horizontal" Margin="0,0,0,14" />
                                <Grid x:Name="ShopItemGrid" Grid.Row="1" Margin="0,4,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Background="#4A5563"
                                Content="全部置 0" Click="ResetShopPurchases_Click" />
                    </StackPanel>
                </Grid>

                <ScrollViewer x:Name="PriorityPanel" Grid.Column="1" Visibility="Collapsed">
                    <StackPanel Margin="42,32,42,30">
                        <TextBlock Text="宝物优先级" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Margin="0,7,0,22"
                                   Text="列表越靠上优先级越高；调整后自动写入配置，缺少模板的宝物会自动跳过。"
                                   Foreground="#9EA7B3" TextWrapping="Wrap" />
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ListBox x:Name="TreasurePriorityList" MinHeight="300"
                                         Background="#171C23" Foreground="#F5F7FA"
                                         BorderBrush="#3A4552" BorderThickness="1"
                                         FontSize="16" Padding="6"
                                         ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="14,12" />
                                            <Setter Property="Margin" Value="2" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                    <Button Style="{StaticResource PrimaryButton}" Width="92"
                                            Content="↑ 上移" Click="MovePriorityUp_Click" />
                                    <Button Style="{StaticResource PrimaryButton}" Width="92" Margin="0,10,0,0"
                                            Content="↓ 下移" Click="MovePriorityDown_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="HotkeyPanel" Grid.Column="1" Visibility="Collapsed">
                    <StackPanel Margin="42,32,42,30">
                        <TextBlock Text="快捷键设置" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,22" />
                        <Border Style="{StaticResource Card}" Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="功能" FontWeight="SemiBold" Foreground="#AEB6C2" />
                                <TextBlock Grid.Column="1" Text="快捷键类型" FontWeight="SemiBold"
                                           Foreground="#AEB6C2" />
                                <TextBlock Grid.Column="2" Text="配置快捷键" FontWeight="SemiBold"
                                           Foreground="#AEB6C2" />
                                <Border Grid.Row="1" Grid.ColumnSpan="3" Height="1" Margin="0,12,0,12"
                                        Background="#3A4552" />
                                <Border Grid.Row="2" Grid.ColumnSpan="3" Padding="4,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="150" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="启动/停止脚本" FontSize="15" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Margin="0,0,18,0" Padding="12,8"
                                                Background="#343C48" CornerRadius="6"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="全局热键" HorizontalAlignment="Center" />
                                        </Border>
                                        <Button x:Name="HotkeyCaptureButton" Grid.Column="2"
                                                Height="36" MinWidth="120"
                                                VerticalAlignment="Center"
                                                Background="#2A323D" Foreground="#F5F7FA"
                                                BorderBrush="#4A5563" BorderThickness="1"
                                                FontSize="14" Cursor="Hand"
                                                Click="HotkeyCaptureButton_Click"
                                                PreviewKeyDown="HotkeyCaptureButton_PreviewKeyDown"
                                                LostKeyboardFocus="HotkeyCaptureButton_LostKeyboardFocus">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Root"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="6">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Root" Property="Background" Value="#343C48" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="SettingsPanel" Grid.Column="1" Visibility="Collapsed">
                    <StackPanel Margin="42,32,42,30">
                        <TextBlock Text="设置" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,22" />
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="诊断模式" FontSize="16" />
                                    <TextBlock Margin="0,6,0,0"
                                               Text="开启后保存识别截图到 diagnostics 目录，便于核对 ROI；平时建议关闭。"
                                               Foreground="#9EA7B3" FontSize="13" TextWrapping="Wrap" />
                                </StackPanel>
                                <CheckBox x:Name="DiagnosticModeCheckBox" Grid.Column="1"
                                          Style="{StaticResource ToggleSwitch}"
                                          VerticalAlignment="Center"
                                          Checked="DiagnosticModeCheckBox_Changed"
                                          Unchecked="DiagnosticModeCheckBox_Changed" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
