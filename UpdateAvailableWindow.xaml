<Window x:Class="BetterMuv.UpdateAvailableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="发现新版本"
        Width="460"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="Transparent"
        AllowsTransparency="True"
        Foreground="#EEF2F6"
        FontFamily="Microsoft YaHei UI"
        FontSize="14">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" CornerRadius="14" GlassFrameThickness="0" ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="#D5DCE5"/>
            <Setter Property="Background" Value="#2A313C"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="10" Padding="14,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#343C48"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#242B35"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#3EA6F1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="10" Padding="14,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#55B3F6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#2F8FD6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="10"
            Background="#232A34"
            BorderBrush="#3A4452"
            BorderThickness="1"
            CornerRadius="14"
            Padding="0,0,0,18">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.28" BlurRadius="22" ShadowDepth="2"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Button HorizontalAlignment="Right"
                        Width="36" Height="36"
                        Content="✕"
                        FontSize="12"
                        Foreground="#8B95A3"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="LaterButton_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>

            <StackPanel Grid.Row="1" Margin="28,8,28,8">
                <TextBlock Text="发现新版本"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"/>
                <TextBlock x:Name="VersionSummaryText"
                           FontSize="13"
                           Foreground="#9AA5B3"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12"/>

                <Border Background="#1A2028"
                        CornerRadius="10"
                        Padding="4,2"
                        MaxHeight="160">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="12,10">
                        <TextBlock x:Name="NotesText"
                                   FontSize="13"
                                   Foreground="#C5CCD6"
                                   TextWrapping="Wrap"
                                   LineHeight="22"/>
                    </ScrollViewer>
                </Border>

                <StackPanel x:Name="ProgressPanel" Margin="0,14,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="ProgressText" Text="正在下载…" Foreground="#AEB8C5" FontSize="12" Margin="0,0,0,6"/>
                    <ProgressBar x:Name="DownloadProgress"
                                 Height="8"
                                 Minimum="0"
                                 Maximum="1"
                                 Value="0"/>
                </StackPanel>
                <TextBlock x:Name="ErrorText"
                           Foreground="#F07178"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0"
                           Visibility="Collapsed"/>
            </StackPanel>

            <Grid Grid.Row="2" Margin="28,14,28,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Button x:Name="UpdateButton"
                        Style="{StaticResource AccentButton}"
                        Content="立即更新"
                        Click="UpdateButton_Click"/>
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="IgnoreButton"
                            Grid.Column="0"
                            Style="{StaticResource GhostButton}"
                            Content="忽略此版本线"
                            ToolTip="同小版本线内不再提示（如 1.3.x），直到出现更高小版本（如 1.4）"
                            Click="IgnoreButton_Click"/>
                    <Button x:Name="LaterButton"
                            Grid.Column="2"
                            Style="{StaticResource GhostButton}"
                            Content="稍后"
                            Click="LaterButton_Click"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
