    <Compile Remove="tests\**\*.cs" />
    <EmbeddedResource Remove="tests\**\*" />
    <None Remove="tests\**\*" />
    <Compile Remove="tools\**\*.cs" />
    <EmbeddedResource Remove="tools\**\*" />
    <None Remove="tools\**\*" />
    <Content Remove="tools\**\*" />
  </ItemGroup>

  <!-- 仅首次复制默认配置，避免重建覆盖运行目录中已改过的 config.json；正式读写在 %LocalAppData%\Better-Muv\ -->
  <Target Name="CopyBundledConfigIfMissing" AfterTargets="Build">
    <Copy SourceFiles="config.json"
          DestinationFiles="$(OutputPath)config.json"
          SkipUnchangedFiles="true"
          Condition="!Exists('$(OutputPath)config.json')" />
  </Target>

</Project>
